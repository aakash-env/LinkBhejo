{
  "family": "linkbhejo-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/linkbhejo-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/linkbhejo/api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3001,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        { "name": "AUTH_SECRET",               "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/AUTH_SECRET" },
        { "name": "DATABASE_URL",              "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/DATABASE_URL" },
        { "name": "REDIS_URL",                 "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/REDIS_URL" },
        { "name": "ANTHROPIC_API_KEY",         "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/ANTHROPIC_API_KEY" },
        { "name": "STRIPE_SECRET_KEY",         "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/STRIPE_SECRET_KEY" },
        { "name": "STRIPE_WEBHOOK_SECRET",     "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/STRIPE_WEBHOOK_SECRET" },
        { "name": "STRIPE_PRO_PRICE_ID",       "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/STRIPE_PRO_PRICE_ID" },
        { "name": "STRIPE_AGENCY_PRICE_ID",    "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/STRIPE_AGENCY_PRICE_ID" },
        { "name": "META_WEBHOOK_VERIFY_TOKEN", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/META_WEBHOOK_VERIFY_TOKEN" },
        { "name": "META_WEBHOOK_SECRET",       "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/META_WEBHOOK_SECRET" },
        { "name": "ENCRYPTION_KEY",            "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/ENCRYPTION_KEY" },
        { "name": "RESEND_API_KEY",            "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/RESEND_API_KEY" },
        { "name": "AWS_S3_BUCKET_NAME",        "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:/linkbhejo/prod/AWS_S3_BUCKET_NAME" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT",     "value": "3001" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/linkbhejo-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3001/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum UserRole {
  OWNER
  AGENCY_ADMIN
  STAFF
  VIEWER
}

enum AutomationType {
  COMMENT
  STORY
  LIVE
  DM_REPLY
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum DmStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum SubscriptionPlan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum KeywordMatchType {
  EXACT
  CONTAINS
  STARTS_WITH
}

enum SequenceEnrollmentStatus {
  ACTIVE
  COMPLETED
  UNSUBSCRIBED
  FAILED
}

// ─────────────────────────────────────────
// Core User & Auth
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(OWNER)
  
  // Agency relationship
  agencyId      String?
  agency        Agency?   @relation("AgencyMembers", fields: [agencyId], references: [id])
  ownedAgency   Agency?   @relation("AgencyOwner")

  // Relations
  accounts      InstagramAccount[]
  subscription  Subscription?
  notifications Notification[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([agencyId])
}

// For NextAuth OAuth accounts (Meta, etc.)
model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
// Agency (Multi-account)
// ─────────────────────────────────────────

model Agency {
  id          String  @id @default(cuid())
  name        String
  ownerId     String  @unique
  owner       User    @relation("AgencyOwner", fields: [ownerId], references: [id])
  members     User[]  @relation("AgencyMembers")
  
  // White-label
  customDomain  String?
  logoUrl       String?
  primaryColor  String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// ─────────────────────────────────────────
// Instagram Accounts
// ─────────────────────────────────────────

model InstagramAccount {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  igUserId            String    @unique  // Instagram User ID from Meta
  igUsername          String
  igName              String?
  profilePictureUrl   String?
  
  // Encrypted access token (AES-256-GCM)
  encryptedAccessToken  String  @db.Text
  tokenExpiresAt        DateTime?
  pageId                String?  // Facebook Page ID linked to this IG account
  
  // Stats cache
  followersCount      Int       @default(0)
  followingCount      Int       @default(0)
  mediaCount          Int       @default(0)
  
  automations         Automation[]
  dmLogs              DmLog[]
  leads               Lead[]
  usageEvents         UsageEvent[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([userId])
  @@index([igUserId])
}

// ─────────────────────────────────────────
// Automations
// ─────────────────────────────────────────

model Automation {
  id              String            @id @default(cuid())
  accountId       String
  account         InstagramAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  name            String
  type            AutomationType
  status          AutomationStatus  @default(DRAFT)
  
  // Trigger config
  postId          String?   // specific post/reel/story ID to watch
  watchAllPosts   Boolean   @default(false)
  
  // DM content
  dmTemplate      String    @db.Text
  dmMediaUrl      String?
  
  // Public comment reply
  commentReplyEnabled Boolean @default(true)
  commentReplyTemplate String? @default("Check your DMs! 📩")
  
  // Settings
  delaySeconds    Int       @default(0)   // 0–60s delay before sending DM
  followGate      Boolean   @default(false) // require follow before DM
  followGateMessage String? 
  
  // AI
  aiEnabled       Boolean   @default(false)
  aiSystemPrompt  String?   @db.Text
  aiBrandVoice    String?   @db.Text
  
  // A/B testing
  abTestEnabled   Boolean   @default(false)
  abTests         AbTest[]
  
  rules           AutomationRule[]
  dmLogs          DmLog[]
  sequences       Sequence[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([accountId])
  @@index([accountId, status])
  @@index([createdAt])
}

model AutomationRule {
  id            String           @id @default(cuid())
  automationId  String
  automation    Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  
  keyword       String
  matchType     KeywordMatchType @default(CONTAINS)
  caseSensitive Boolean          @default(false)
  
  // Override DM template per-rule (optional)
  customTemplate String?         @db.Text
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([automationId])
}

// ─────────────────────────────────────────
// DM Logs
// ─────────────────────────────────────────

model DmLog {
  id            String           @id @default(cuid())
  automationId  String
  automation    Automation       @relation(fields: [automationId], references: [id])
  accountId     String
  account       InstagramAccount @relation(fields: [accountId], references: [id])
  
  // Target user
  igUserId      String           // Instagram user who commented/messaged
  igUsername    String?
  
  // Message details
  messageText   String           @db.Text
  mediaUrl      String?
  
  // Status
  status        DmStatus         @default(PENDING)
  errorMessage  String?
  metaMessageId String?          // Meta's message ID for delivered confirmation
  
  // Trigger context
  triggerType   String           // "comment", "story_reply", "live_comment", "dm_keyword"
  triggerPostId String?
  triggeredAt   DateTime         @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  
  // A/B testing
  abVariant     String?          // "A" or "B"

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([automationId, igUserId])  // Idempotency constraint
  @@index([accountId])
  @@index([automationId])
  @@index([status])
  @@index([createdAt])
  @@index([igUserId])
}

// ─────────────────────────────────────────
// Leads
// ─────────────────────────────────────────

model Lead {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id])
  
  igUserId    String
  igUsername  String?
  name        String?
  email       String?
  phone       String?
  
  source      String           // automation name or ID
  tags        String[]
  notes       String?          @db.Text
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([accountId])
  @@index([accountId, email])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// Drip Sequences
// ─────────────────────────────────────────

model Sequence {
  id            String           @id @default(cuid())
  automationId  String
  automation    Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?
  
  steps         SequenceStep[]
  enrollments   SequenceEnrollment[]
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([automationId])
}

model SequenceStep {
  id          String    @id @default(cuid())
  sequenceId  String
  sequence    Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  
  stepNumber  Int
  dayOffset   Int       // days after enrollment (0 = immediate, 1 = next day, etc.)
  template    String    @db.Text
  mediaUrl    String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sequenceId])
}

model SequenceEnrollment {
  id            String                   @id @default(cuid())
  sequenceId    String
  sequence      Sequence                 @relation(fields: [sequenceId], references: [id])
  
  igUserId      String
  igUsername    String?
  currentStep   Int                      @default(0)
  status        SequenceEnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime                 @default(now())
  completedAt   DateTime?

  @@unique([sequenceId, igUserId])
  @@index([sequenceId])
  @@index([status])
}

// ─────────────────────────────────────────
// A/B Testing
// ─────────────────────────────────────────

model AbTest {
  id            String      @id @default(cuid())
  automationId  String
  automation    Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  
  variantA      String      @db.Text  // DM template A
  variantB      String      @db.Text  // DM template B
  
  sentA         Int         @default(0)
  sentB         Int         @default(0)
  repliedA      Int         @default(0)
  repliedB      Int         @default(0)
  
  sampleSize    Int         @default(100)  // auto-promote after N sends
  winnerVariant String?     // "A" or "B" — set when winner determined
  isActive      Boolean     @default(true)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([automationId])
}

// ─────────────────────────────────────────
// Billing & Subscriptions
// ─────────────────────────────────────────

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan                SubscriptionPlan   @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)
  
  stripeCustomerId    String?            @unique
  stripeSubscriptionId String?           @unique
  stripePriceId       String?
  
  razorpayCustomerId  String?
  razorpaySubscriptionId String?
  
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  
  // Plan limits (JSON — checked via middleware)
  limits              Json               @default("{\"dmsPerMonth\": 50, \"maxAccounts\": 1, \"aiEnabled\": false, \"sequencesEnabled\": false}")
  
  cancelAtPeriodEnd   Boolean            @default(false)
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ─────────────────────────────────────────
// Usage Tracking
// ─────────────────────────────────────────

model UsageEvent {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id])
  
  type        String           // "dm_sent", "comment_reply", "ai_call"
  month       String           // "2025-01" format for easy aggregation
  count       Int              @default(0)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([accountId, type, month])
  @@index([accountId])
  @@index([month])
}

// ─────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String    // "usage_alert", "payment_failed", "weekly_summary", "automation_error"
  title     String
  message   String    @db.Text
  read      Boolean   @default(false)
  actionUrl String?
  
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, read])
}

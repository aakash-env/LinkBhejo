{
  "name": "linkbhejo",
  "private": true,
  "version": "1.0.0",
  "description": "Instagram DM Automation SaaS",
  "scripts": {
    "dev": "turbo run dev worker --parallel",
    "dev:web": "pnpm --filter @linkbhejo/web dev",
    "dev:api": "pnpm --filter @linkbhejo/api dev",
    "dev:worker": "pnpm --filter @linkbhejo/api worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @linkbhejo/db prisma generate",
    "db:push": "pnpm --filter @linkbhejo/db prisma db push",
    "db:migrate": "pnpm --filter @linkbhejo/db prisma migrate dev",
    "db:studio": "pnpm --filter @linkbhejo/db prisma studio",
    "db:seed": "pnpm --filter @linkbhejo/db seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.4.5",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.2",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
